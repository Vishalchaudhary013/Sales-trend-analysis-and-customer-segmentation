# Local settings for the Sales Trend Analysis & Customer Segmentation Dashboard.
#
# 1. Copy this file to ".env" in the project root (same folder as app.py).
# 2. Uncomment and change only the lines you need; anything left commented uses the default.
# 3. Restart the app (Ctrl+C, then: streamlit run app.py).
#
# Real environment variables take precedence over this file. ".env" is git-ignored.
# Relative paths are resolved from the project root. An invalid value is ignored (the
# default is used) and every page shows a message naming the variable.

# --- Folders and files ------------------------------------------------------------
# DATA_DIR=data                      # raw + processed data and uploads
# MODELS_DIR=models                  # saved churn model (+ JSON metadata)
# REPORTS_DIR=reports                # exported figures and metrics
# DB_PATH=data/app.db                # SQLite history (uploads, models, prediction runs)

# --- Display ----------------------------------------------------------------------
# DEFAULT_DISPLAY_CURRENCY=GBP       # one of: GBP USD EUR INR JPY CNY AUD CAD CHF SGD HKD
#                                    #   NZD SEK NOK DKK ZAR BRL MXN KRW MYR THB TWD
# LARGE_LINE_QUANTITY=10000          # |quantity| at/above this is listed as an outlier
# EXPORT_DPI=300                     # PNG resolution for exported figures (72-600)

# --- Churn model ------------------------------------------------------------------
# CHURN_HORIZON_DAYS=90              # churn = no purchase in this many days (30-180)
# DEFAULT_THRESHOLD=0.5              # probability at/above which a customer is flagged (0-1)
# RISK_HIGH=0.7                      # High-risk tier starts here (0-1)
# RISK_MEDIUM=0.4                    # Medium-risk tier starts here (must be < RISK_HIGH)
# TOP_N_REASONS=3                    # reasons shown per customer (1-5)
# RANDOM_STATE=42                    # seed for cross-validation and models
